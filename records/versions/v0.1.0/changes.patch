+
+test('zero masses, coincident initial bodies and zero softening remain finite', () => {
+  for(const config of [
+    {_110:0,_26:0,_34:0,newproperty8:0},
+    {newproperty50:true,x11:0,y11:0,x21:0,y21:0,x3:0,y3:0,x4:0,y4:0},
