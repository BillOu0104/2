+ const escaping=initial.map(b=>({...b,x:b.x+100}));const shown=frame.position(escaping[0]);assert.equal(shown.x,escaping[0].x-origin.x);assert.deepEqual(frame.origin,origin);assert.deepEqual(initial,before);
