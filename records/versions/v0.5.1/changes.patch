+const body=(x,mass=1000,vy=0)=>({x,y:0,z:0,vx:0,vy,vz:0,mass});
+const bodies=()=>[body(1,1e6,1),body(20),body(-20),body(0,5000)];
+test('stable-era confirmation requires one simulated month, not a two-year window',()=>{
